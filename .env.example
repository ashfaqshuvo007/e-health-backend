# development includes the raw error and stack trace in API error responses
NODE_ENV=
# Port the HTTP server listens on
PORT=
# Postgres connection string, used by both Prisma and the app
DATABASE_URL=
# Signing key for access tokens
JWT_ACCESS_SECRET=
# Signing key for refresh tokens
JWT_REFRESH_SECRET=
# Access token lifetime (e.g. 15m, 1d)
JWT_ACCESS_EXPIRES_IN=
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=
# Read into config but not wired up yet — password hashing currently uses a hardcoded value (see below)
BCRYPT_SALT_ROUNDS=
# Read into config but not used anywhere yet
BACKEND_URL=
# Added to the CORS allowlist
FRONTEND_URL=
#Google Client
GOOGLE_CLIENT_ID=