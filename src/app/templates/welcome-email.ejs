<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome To Algo E-Health</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f7; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f7; padding:30px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,0.08);">
          <!-- Header -->
          <tr>
            <td style="background-color:#16a34a; padding:24px; text-align:center;">
              <h1 style="color:#ffffff; margin:0; font-size:20px;">Welcome to Algo E-Health System</h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:32px 24px;">
              <!-- Success Icon -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding:0 0 20px;">
                    <span style="display:inline-block; width:56px; height:56px; line-height:56px; background-color:#dcfce7; color:#16a34a; font-size:28px; font-weight:bold; border-radius:50%;">
                      &#10003;
                    </span>
                  </td>
                </tr>
              </table>

              <p style="font-size:15px; color:#333333; margin:0 0 16px;">
                Hi <strong><%= name %></strong>,
              </p>
              <p style="font-size:15px; color:#333333; margin:0 0 16px;">
                We welcome you to Algo E-Health. Your account is verified now. You can login to our portal to avail the amazing services we have for you.
              </p>

              <p style="font-size:14px; color:#666666; margin:24px 0 0;">
                Please contact our support team immediately if you need any help from us.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f9f9fb; padding:16px 24px; text-align:center;">
              <p style="font-size:12px; color:#999999; margin:0;">
                &copy; <%= new Date().getFullYear() %> Algodevs E-Health. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
